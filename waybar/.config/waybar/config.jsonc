{
        "layer": "top",
        "position": "top",
        "reload_style_on_change": true,
        "modules-left": ["hyprland/workspaces"],
        "modules-center": ["clock"],
        "modules-right": ["custom/mpris", "network", "battery", "bluetooth", "custom/volume", "custom/logout"],
        "hyprland/workspaces": {
                "format": "{icon}",
                "on-click": "activate",
                "format-icons": {
                    "1": "",
                    "2": "",
                    "3": "",
                    "4": "",
                    "5": "",
                    "6": "",
                    "7": "",
                    "8": "",
                    "9": "",
                    "active": "",
                    "urgent": "",
                    "persistent": "",
                    "focused": "",
                    "default": ""
                        },
                "sort-by-number": true

		},
        "clock": {
            "format-alt": "{:L%A %d/%m - %I:%M %p}",
            "format": "{:L%I:%M %p}"
            
		},
        "network": {
            "format-wifi": " ",
            "format-ethernet":" ",
            "format-disconnected": "",
            "on-click": "kitty waybar/.config/waybar/network.sh"
        },
        "bluetooth": {
            "format": "󰂯 {status}",
            "format-on": "󰂯",
            "format-off": "󰂯 off",
            "format-disabled": "󰂲",
            "format-no-controller": "󰂲",
	    	"format-connected-battery": "{device_battery_percentage}% 󰂯",
            "on-click": "kitty waybar/.config/waybar/bluetooth.sh"
        },

        "custom/logout": {
            "format": "󰗼",
            "on-click": "~/.config/rofi/powermenu.sh > /dev/null"
        },
        
        "battery": {
            "format": "   {capacity}%",
            "format-charging": "   {capacity}%",
            "format-plugged": "   {capacity}%",
            "interval": 30,
            "tooltip": true,
            "on-click": "kitty waybar/.config/waybar/power.sh"
        },
    
        "custom/volume": {
        "format": "   {}",
        "exec": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100) \"%\"}'",
        "interval": 2
        },

        "custom/mpris": {
            "exec": "playerctl metadata --format '{{ title }} - {{ artist }}' | awk '{ if (length($0) > 45) print substr($0, 1, 45) \"...\"; else print $0 }'",
            "interval": 5,
            "return-type": "plain",
            "format": "🎵 {}",
            "tooltip": false
        }

} 
